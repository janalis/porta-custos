{
    "name": "janalis/porta-custos",
    "description": "custos, the PHP inspector and fixer, as a supplementary language server and a file fixer",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "Porta\\Custos\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "tools": [
                {
                    "name": "custos",
                    "purpose": "the inspector and fixer",
                    "setting": "binary",
                    "sources": [
                        [
                            "github",
                            "janalis/custos",
                            {
                                "asset": "custos_{os}_{arch}",
                                "os": {
                                    "Darwin": "darwin",
                                    "Linux": "linux"
                                },
                                "arch": {
                                    "arm64": "arm64",
                                    "aarch64": "arm64",
                                    "x86_64": "amd64",
                                    "amd64": "amd64"
                                }
                            }
                        ],
                        [
                            "brew-cask",
                            "janalis/tap/custos"
                        ]
                    ]
                }
            ],
            "store": {
                "title": "Custos",
                "category": "linters"
            }
        }
    }
}
